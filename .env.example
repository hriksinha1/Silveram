# Environment Configuration Template for Silveram
# Copy to .env.local for local development

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/silveram_mvp?retryWrites=true&w=majority
MONGODB_DB=silveram_mvp

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Cloudflare R2 Media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_MEDIA_DOMAIN=https://media.silveram.example

# Brevo (Email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@silveram.example
BREVO_SENDER_NAME=Silveram

# Payments (Razorpay or configured gateway)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Admin Authentication
ADMIN_SECRET_KEY=
