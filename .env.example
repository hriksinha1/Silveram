# Copy to .env.local for local development. Only VITE_* variables are exposed to the browser.

# Public site URL (used for canonical / Open Graph tags at build time)
VITE_APP_URL=http://localhost:3000

# Appwrite (client-safe values)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=silveram
VITE_APPWRITE_PRODUCTS_COLLECTION_ID=products
VITE_APPWRITE_ENQUIRIES_COLLECTION_ID=corporate_enquiries
VITE_APPWRITE_CREATE_ORDER_FUNCTION_ID=create-order

# --- Server-only (NEVER prefix with VITE_). Used by `npm run appwrite:setup` only. ---
APPWRITE_API_KEY=
